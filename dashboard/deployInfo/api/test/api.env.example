NODE_ENV=production
API_PORT=3001
TRUST_PROXY_HOPS=1
MONGODB_URI=mongodb://127.0.0.1:27017/auto_tags
WEB_ORIGIN=https://app.example.com
API_PUBLIC_URL=https://api.example.com
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
LOG_PRETTY=false
USD_TO_VND_RATE=26000
AI_ORDER_RATE_LIMIT_PER_MINUTE=5
AI_ORDER_IP_RATE_LIMIT_PER_MINUTE=20
AI_ORDER_MAX_PENDING_PER_USER=2
