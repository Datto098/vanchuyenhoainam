# API reads the repository root .env. This file documents API-specific values.
NODE_ENV=development
API_PORT=3001
MONGODB_URI=mongodb://localhost:27017/auto_tags
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
GOOGLE_STORAGE_BUCKET_NAME=uid-dev
GOOGLE_STORAGE_PROJECT_ID=dev-uid
SHOPIFY_API_VERSION=2026-07
SHOPIFY_REQUIRED_SCOPES=read_products,read_orders,read_reports
