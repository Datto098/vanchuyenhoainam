{
"update_url": "https://clients2.google.com/service/update2/crx",

	"manifest_version": 3,
	"name": "Vận Chuyển Hoài Nam",
		"version": "3.0.2",
		"description": "Gửi dữ liệu sản phẩm Trung Quốc tới AI Order Dashboard.",
	"permissions": ["storage"],
	"host_permissions": [
		"https://vanchuyenhoainam.vn/*",
		"https://*.taobao.com/*",
		"https://*.tmall.com/*",
		"https://*.1688.com/*",
		"https://api-agent.dttech.site/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://vanchuyenhoainam.vn/*"],
			"js": ["login-content.js"],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://item.taobao.com/*",
				"https://detail.tmall.com/*",
				"https://detail.1688.com/*"
			],
			"js": ["content.js"]
		}
	],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icon.png"
		}
	}
}
